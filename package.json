{
  "name": "@lumine-code/superstring",
  "author": "lumine-code",
  "version": "4.0.0",
  "description": "Provides native text patches, marker indexing, and text storage for Lumine.",
  "main": "./index",
  "browser": "./browser",
  "scripts": {
    "build:node": "node-gyp rebuild",
    "build:browser": "script/build-browser-version.sh",
    "build": "npm run build:node && npm run build:browser",
    "test:native": "node ./script/test-native.js",
    "test:node": "mocha test/js/*.test.js",
    "test:threads": "node ./test/js/threads-outer.js",
    "test:browser": "SUPERSTRING_USE_BROWSER_VERSION=1 mocha test/js/*.js",
    "test": "npm run test:node && npm run test:browser",
    "benchmark": "node benchmark/marker-index.benchmark.js",
    "standard": "standard --recursive src test"
  },
  "repository": "https://github.com/lumine-code/superstring",
  "keywords": [
    "text",
    "data-structure"
  ],
  "engines": {
    "node": ">=16"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "bugs": "https://github.com/lumine-code/superstring/issues",
  "homepage": "https://github.com/lumine-code/superstring",
  "devDependencies": {
    "chai": "^2.0.0",
    "mocha": "^2.3.4",
    "random-seed": "^0.2.0",
    "standard": "^4.5.4",
    "temp": "^0.8.3",
    "unzip": "^0.1.11"
  },
  "standard": {
    "global": [
      "describe",
      "it",
      "expect"
    ]
  },
  "dependencies": {
    "node-addon-api": "^8.5.0"
  }
}
